[user]
	name = YOUR_NAME
	email = YOUR_EMAIL
[credential]
	helper = osxkeychain
[core]
	autocrlf = input
	pager = delta
[interactive]
	difffilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colormoved = default
[pull]
	rebase = true
