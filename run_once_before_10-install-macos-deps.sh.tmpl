{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

echo "[chezmoi] macOS 依存ツール導入"

# Homebrew
if ! command -v brew &>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# brew install (idempotent)
brew install \
  starship zoxide atuin fzf zsh-autosuggestions zsh-syntax-highlighting \
  bat eza ripgrep fd yazi \
  git gh git-delta lazygit lazydocker lazysql ghq \
  neovim tmux mise btop glow age bitwarden-cli chezmoi || true

brew install --cask ghostty wezterm font-hackgen-nerd bitwarden karabiner-elements || true

# tmux TPM
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

echo "[chezmoi] macOS 依存ツール導入完了"
{{- end }}
